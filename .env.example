# Pegue esses valores em https://cloud.livekit.io → seu projeto → Settings → Keys
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Opcional: se preencher, só entra quem souber esse código
CODIGO_ACESSO=

# Discord Developer Portal → seu app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL pública https do Telinha (túnel ou deploy) — usada pela Atividade para abrir o navegador
PUBLIC_URL=

PORT=3000
